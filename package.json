{
  "name": "linkup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:vercel": "npx --yes vercel dev --local",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "test": "vitest run",
    "mentor:test-live": "tsx --env-file-if-exists=.env.local scripts/test-mentor-live.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
